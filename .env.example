# No deployer key here. The deploy script broadcasts as whichever sender forge is given
# (--private-key / --account / --keystore / --sender), and nothing in the environment
# overrides it.
#
# Launch fees and the protocol mint share are paid here.
TREASURY=
# Reveal-worker signer for one-shot LIVE token metadata. It cannot launch or mint.
PLATFORM_SIGNER=
# Factory admin. Defaults to the broadcasting deployer when unset.
FACTORY_OWNER=
# Payment-token override. Leave unset: non-mainnet deployments publish a TestnetWETH and
# mainnet resolves canonical WETH on its own. Set it only to point at a token that exists on
# the target chain; the address is immutable once the factory is live.
WETH=
# Supplying WETH on chain 46630 bypasses TestnetWETH deployment and requires this explicit
# acknowledgment. Leave both values unset for a clean testnet rotation.
ALLOW_TESTNET_WETH_OVERRIDE=false
# TestnetWETH admin. Defaults to FACTORY_OWNER. Keep this off the API host.
TESTNET_WETH_OWNER=
# Hot wallet allowed to sponsor one bounded faucet claim per recipient per day. This can be the
# platform signer because the role cannot mint or administer the token. Required on chain 46630.
TESTNET_FAUCET_OPERATOR=
# Finite TestnetWETH reserve held by the token contract, in 18-decimal wei. The default is
# 1,000,000 WETH; each claim transfers 1 WETH without minting new supply.
TESTNET_FAUCET_RESERVE=1000000000000000000000000
# Operational address recorded beside the testnet contracts. Required on chain 46630 so a
# deployment record cannot silently lose the keeper binding during rotation. It must be a
# separately funded address, not PLATFORM_SIGNER; the deploy script enforces it.
GRADUATION_KEEPER=
# HTTPS origin serving each collection's ERC-7572 document, with no trailing slash. A
# collection reads it at creation and keeps it, so it is required on chains 4663 and 46630 and
# the deploy script refuses any other shape.
ASSET_ORIGIN=https://api.ripples.run
# Uniswap V4 PoolManager. Required on testnet. Mainnet is pinned to the canonical 4663
# address; a different supplied value reverts rather than becoming an immutable bad binding.
POOL_MANAGER=
# Token-rail launch fee override in WETH wei. Unset keeps the 0.0005 WETH contract default.
TOKEN_LAUNCH_FEE=
# Required to broadcast on Robinhood Chain mainnet (4663).
ALLOW_MAINNET_DEPLOY=false
# deployments.json is only ever written by a --broadcast run on 4663 or 46630; simulations,
# fork rehearsals and tests print the record and leave the file alone. Set false to keep even
# a real broadcast from rewriting it.
WRITE_DEPLOYMENTS=true
# The revision being deployed, recorded so the live bytecode can be rebuilt and verified later.
# Required on any run that writes deployments.json: SOURCE_COMMIT=$(git rev-parse HEAD)
SOURCE_COMMIT=
# Verification: RPC endpoint the verify script reads the factory through.
RPC_URL=
